OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Storage bucket that generated assets are uploaded to.
# Defaults to "TerraVow" so existing uploads keep working; point this at an
# AtlasAir-named bucket once you have created it in Supabase.
SUPABASE_BUCKET=AtlasAir

# Where generated assets are written when storageDestination is "local", and
# where product copy and FAQs are always written. Use an absolute path; leave
# commented out for the default, ~/Desktop/AtlasAirAssets.
# ASSET_OUTPUT_ROOT=/Users/you/Desktop/AtlasAirAssets
